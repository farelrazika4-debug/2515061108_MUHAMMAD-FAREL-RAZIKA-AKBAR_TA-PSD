def binary_search(arr, n, target):
    left = 0
    right = n - 1

    while left <= right:
        mid = left + (right - left) // 2

        print(f"Index tengah: {mid}, Nilai tengah: {arr[mid]}")

        # Jika data ditemukan
        if arr[mid] == target:
            return mid

        # Jika target lebih besar
        elif arr[mid] < target:
            print("Mencari ke bagian kanan")
            left = mid + 1

        # Jika target lebih kecil
        else:
            print("Mencari ke bagian kiri")
            right = mid - 1

    return -1


def main():
    try:
        n = int(input("Masukkan jumlah data: "))
    except ValueError:
        print("Input harus berupa angka!")
        return

    data = []

    print("Masukkan data secara urut menaik:")

    for i in range(n):
        while True:
            try:
                nilai = int(input(f"Data ke-{i + 1}: "))
                data.append(nilai)
                break
            except ValueError:
                print("Input tidak valid, masukkan angka!")

    print(f"\nData array: {data}")

    while True:
        try:
            target = int(input("Masukkan angka yang ingin dicari: "))
            break
        except ValueError:
            print("Input tidak valid, masukkan angka!")

    hasil = binary_search(data, n, target)

    if hasil != -1:
        print(f"Data ditemukan pada indeks ke-{hasil}")
    else:
        print("Data tidak ditemukan")


if __name__ == "__main__":
    main()
